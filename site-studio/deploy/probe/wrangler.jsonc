// The cross-host password probe (story 1.3, D-6, A-22, V-3). A small test Worker, never part of
// the app's build: it imports the app's own `server/auth/password.ts` and checks that a hash made on
// one host verifies on the other. Its compatibility date and flags copy the app's
// (`deploy/cloudflare/wrangler.jsonc`); `deploy/probe/probe.mjs` refuses to run if they differ.
// Built with `wrangler deploy --dry-run --outdir`; deployed to the test account only by spec 4, and
// deleted afterwards.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "site-studio-password-probe",
  "main": "index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": true
}
