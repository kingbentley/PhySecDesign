// Site Survey Design on Cloudflare (AD-1, AD-16). Paths are relative to this file.
// Allowed platform features only: Durable Objects with SQLite, their alarms and web-standard
// APIs. No D1, Workflows, Queues, cron triggers or KV (server-tests/host-config.test.ts checks).
// The two Durable Object classes are fixed from the first release (AD-20): adding, renaming or
// removing one blocks Cloudflare's rollback.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "site-studio",
  "main": "../../server/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "../../dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/mcp", "/mcp/*", "/.well-known", "/.well-known/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "PROJECT_ROOM", "class_name": "ProjectRoom" },
      { "name": "INSTALLATION", "class_name": "Installation" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProjectRoom", "Installation"] }],
  "observability": { "enabled": true }
}
