# Dependencies, generated builds, and local runtime files.
node_modules/
dist/
.vite/
*.log
/site-studio/public/pdfjs/

# Local environment settings; keep safe example files trackable.
.env
.env.*
!.env.example
!.env.*.example

# Third-party reference screenshots remain local; public references use links.
/design-references/*-reference.png

# All BMAD framework files, configuration, and customizations.
# Recreate these with the BMAD installer.
/_bmad/*

# Agent and BMAD tooling: skills, local agent settings and the skills lock (the owner's
# instruction, 2026-11-25: of BMAD's files only the output folder is pushed).
/.agents/
/.claude/
/skills-lock.json

# Intentionally keep AGENTS.md and _bmad-output/ planning artifacts trackable.

# Local state written by Cloudflare tooling.
.wrangler/

# Throwaway files made by the experiments: test certificates and keys, runtime copies, output.
/experiments/r13-smtp/certs/
/experiments/r14-runtime-upgrade/runtimes/
/experiments/*/data*/
/experiments/**/*.out

# Temporary self-hosted configuration written by the smoke test (holds a throwaway set-up code).
/site-studio/deploy/selfhost/.smoke-*.capnp

# Local Worker secrets (for example a test set-up code); never commit them.
.dev.vars
.dev.vars.*

# Browser tests: per-run server state and set-up code, and Playwright's output.
/site-studio/browser-tests/.local/
/site-studio/test-results/
/site-studio/playwright-report/
